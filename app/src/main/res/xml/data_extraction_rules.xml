<?xml version="1.0" encoding="utf-8"?>
<!-- トークンと曲ファイル・ジャケットは自動バックアップから除外する(9.3) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_tokens.xml" />
        <exclude domain="file" path="music/" />
        <exclude domain="file" path="covers/" />
        <exclude domain="file" path="updates/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_tokens.xml" />
        <exclude domain="file" path="music/" />
        <exclude domain="file" path="covers/" />
        <exclude domain="file" path="updates/" />
    </device-transfer>
</data-extraction-rules>
